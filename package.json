{
  "name": "verona-modules-aspect",
  "config": {
    "player_version": "3.1.2",
    "editor_version": "3.1.2",
    "unit_definition_version": "4.14.0",
    "unit_definition_min_version": "4.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start-editor-local": "ng serve editor --port 4211",
    "start-player-local": "ng serve player --port 4212",
    "start-editor-e2e": "ng serve editor --port 4201",
    "start-player-e2e": "ng serve player --port 4202",
    "build-editor": "scripts/build.sh editor $npm_package_config_editor_version",
    "build-player": "scripts/build.sh player $npm_package_config_player_version",
    "test": "npm run test:scripts && npm run test:common && npm run test:player-modules && npm run test:editor && npm run test:editor-modules && npm run test:player",
    "test:coverage": "npm run test:common -- --coverage && npm run test:player-modules -- --coverage && npm run test:editor -- --coverage && npm run test:editor-modules -- --coverage && npm run test:player -- --coverage && scripts/merge-coverage.sh",
    "test:common": "ng test common --watch=false",
    "test:player-modules": "ng test playerModules --watch=false",
    "test:editor": "ng test editor --watch=false",
    "test:player": "ng test player --watch=false",
    "lint": "node scripts/check-migrations-registered.js && eslint .",
    "e2e": "npx cypress open",
    "e2e-headless": "npx cypress run",
    "e2e-headless-simple": "npx cypress run --spec 'e2e/tests/simple/**/*.spec.cy.ts'",
    "e2e-headless-complex": "npx cypress run --spec 'e2e/tests/complex/**/*.spec.cy.ts'",
    "e2e-coverage": "scripts/e2e-coverage.sh",
    "docs": "compodoc -p tsconfig.doc.json -n \"Verona Module Aspect\" -d dist/docs",
    "generate-migration": "node scripts/generate-migration.js",
    "serve-editor-coverage": "ng run editor:serve-coverage",
    "serve-player-coverage": "ng run player:serve-coverage",
    "test:editor-modules": "ng test editorModules --watch=false",
    "test:scripts": "node --test scripts/migration-steps.test.js"
  },
  "private": true,
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "dependencies": {
