{
  "name": "verona-modules-aspect",
  "config": {
    "player_version": "3.0.0-beta.2",
    "editor_version": "3.0.0-beta.2",
    "unit_definition_version": "4.12.0",
    "unit_definition_min_version": "4.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start-editor-local": "ng serve editor --port 4201",
    "start-player-local": "ng serve player --port 4202",
    "build-editor": "scripts/build.sh editor $npm_package_config_editor_version",
    "build-player": "scripts/build.sh player $npm_package_config_player_version",
    "test": "npm run test:common && npm run test:player-modules && npm run test:editor && npm run test:editor-modules && npm run test:player",
    "test:common": "ng test common --watch=false",
    "test:player-modules": "ng test playerModules --watch=false",
    "test:editor": "ng test editor --watch=false",
    "test:player": "ng test player --watch=false",
    "lint": "eslint projects",
    "e2e": "npx cypress open",
    "e2e-headless": "npx cypress run",
    "generate-migration": "node scripts/generate-migration.js",
    "serve-editor-coverage": "ng run editor:serve-coverage",
    "serve-player-coverage": "ng run player:serve-coverage",
    "test:editor-modules": "ng test editorModules --watch=false"
  },
  "private": true,
  "eslintConfig": {
    "extends": "@iqb/eslint-config",
    "parserOptions": {
      "ignores": [
        "**/dist/*.*",
        "**/scripts/*.*",
        "**/test-data/*.*",
        "./dist/*",
        "./node_modules"
      ],
      "project": "./tsconfig.json"
    },
    "ignorePatterns": [
      "**/assets/**",
      "**/dist/*.*",
      "**/scripts/*.*",
      "**/test-data/*.*",
      "./dist/**/*",
      "./node_modules/**/*"
    ],
    "rules": {
      "function-call-argument-newline": "OFF",
      "@typescript-eslint/indent": [
        "error",
        2,
        {
          "SwitchCase": 1,
          "FunctionDeclaration": {
            "parameters": "first"
          },
          "FunctionExpression": {
            "parameters": "first"
          },
          "CallExpression": {
            "arguments": "first"
          }
        }
      ],
      "class-methods-use-this": [
        "error",
        {
          "exceptMethods": [
            "getElementComponent",
            "getNewOptionLabel",
            "getTranslation",
            "transform"
          ]
        }
      ],
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "e2e-tests/**/*.ts"
        ],
        "rules": {
          "@typescript-eslint/no-unused-expressions": [
            "error",
            {
              "allowTaggedTemplates": true
            }
          ],
          "newline-per-chained-call": [
            "off"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.9",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/elements": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.9",
    "@angular/platform-browser-dynamic": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@iqb/mathlive": "^0.4.1",
    "@iqb/responses": "^3.3.2",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-blockquote": "^2.11.5",
    "@tiptap/extension-bold": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-bullet-list": "^2.11.5",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-floating-menu": "^2.11.5",
    "@tiptap/extension-font-family": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-horizontal-rule": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-italic": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-ordered-list": "^2.11.5",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-strike": "~2.11.5",
    "@tiptap/extension-subscript": "^2.11.5",
    "@tiptap/extension-superscript": "^2.11.5",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "katex": "^0.16.11",
    "ngx-tiptap": "^11.1.0",
    "ngx-translate-testing": "^7.0.0",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.41.3",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.1.0",
    "@angular-devkit/build-angular": "^21.2.9",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.9",
    "@cypress/code-coverage": "^4.0.3",
    "@iqb/eslint-config": "^2.1.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.0",
    "@jsdevtools/coverage-istanbul-loader": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.20.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.10.0",
    "iqb-dev-components": "^1.4.1",
    "playwright": "^1.61.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
